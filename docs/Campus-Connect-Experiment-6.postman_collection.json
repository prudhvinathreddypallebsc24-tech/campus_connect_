{
  "info": {
    "name": "Campus Connect — Experiment 6 REST API",
    "description": "CS3301 Full Stack Development — Experiment 6\nDeveloping and Consuming Backend Services Using RESTful API Principles\n\nImport this collection into Postman to test all CRUD endpoints.\n\nMake sure the server is running:\n  cd server\n  npm run dev\n\nBase URL: http://localhost:5000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Root — API Info",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        },
        "description": "Returns API information and available endpoints."
      }
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "TEST 1 — GET All Students",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            },
            "description": "Returns all students in the store.\nExpected: 200 OK with count and data array."
          }
        },
        {
          "name": "TEST 2 — GET Single Student (STU001)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/STU001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "STU001"]
            },
            "description": "Returns student with ID STU001.\nExpected: 200 OK with student data."
          }
        },
        {
          "name": "TEST 3 — GET Invalid ID (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/INVALID",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "INVALID"]
            },
            "description": "Attempts to fetch a non-existent student.\nExpected: 404 Not Found with error message."
          }
        },
        {
          "name": "TEST 4 — POST Create Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Student\",\n  \"email\": \"test@example.com\",\n  \"department\": \"Computer Science\",\n  \"year\": 2,\n  \"skills\": [\"Java\", \"Node.js\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            },
            "description": "Creates a new student record.\nExpected: 201 Created with new student data.\n\nNote: Reset server (restart) if student was already created."
          }
        },
        {
          "name": "TEST 5 — POST Invalid (Missing Name) → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"missing@name.com\",\n  \"department\": \"Computer Science\",\n  \"year\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            },
            "description": "Sends a POST request with missing name field.\nExpected: 400 Bad Request with validation error message."
          }
        },
        {
          "name": "TEST 5b — POST Invalid Email → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad Email Student\",\n  \"email\": \"not-an-email\",\n  \"department\": \"CS\",\n  \"year\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            },
            "description": "Sends a POST with invalid email format.\nExpected: 400 Bad Request."
          }
        },
        {
          "name": "TEST 5c — POST Skills Not Array → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Skills Test\",\n  \"email\": \"skills@test.com\",\n  \"department\": \"CS\",\n  \"year\": 2,\n  \"skills\": \"JavaScript\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            },
            "description": "Sends skills as a string instead of array.\nExpected: 400 Bad Request."
          }
        },
        {
          "name": "TEST 6 — PUT Update Student (STU001)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"year\": 3,\n  \"skills\": [\"React\", \"Node.js\", \"AWS\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/students/STU001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "STU001"]
            },
            "description": "Updates year and skills of STU001.\nExpected: 200 OK with updated student data."
          }
        },
        {
          "name": "TEST 7 — DELETE Student (STU001)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/STU001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "STU001"]
            },
            "description": "Deletes student with ID STU001.\nExpected: 200 OK with deleted student data."
          }
        },
        {
          "name": "TEST 8 — Verify Delete (STU001 → 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/STU001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "STU001"]
            },
            "description": "Verifies that STU001 no longer exists after deletion.\nExpected: 404 Not Found."
          }
        }
      ]
    },
    {
      "name": "Middleware Tests",
      "item": [
        {
          "name": "TEST 9 — Unknown Route (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/unknown-route",
              "host": ["{{baseUrl}}"],
              "path": ["api", "unknown-route"]
            },
            "description": "Tests the notFound middleware.\nExpected: 404 with 'Route not found' message."
          }
        }
      ]
    }
  ]
}
